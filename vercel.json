{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.mjs": { "maxDuration": 30 }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.mjs?__fa_route=api/$1" },
    { "src": "/(admin|portal|login|invite|reset)(/.*)?", "dest": "/api/index.mjs?__fa_route=$1$2" },
    { "src": "/favicon.ico", "dest": "/favicon.svg" },
    { "handle": "filesystem" }
  ]
}
